# ============================================================
# Meta Marketing Dashboard - Environment Configuration
# ============================================================

# Facebook Portfolio Tokens
# Lấy từ Facebook Business Manager hoặc Graph API Explorer
# Mỗi portfolio là một business/portfolio chứa nhiều Page

TOKEN_PORTFOLIO_1=your_token_here
TOKEN_PORTFOLIO_2=your_token_here

# ============================================================
# Server Configuration
# ============================================================

PORT=3000
HOST=localhost

# ============================================================
# Security (BẮT BUỘC cho production)
# ============================================================

# Đăng nhập dashboard
APP_USERNAME=admin
APP_PASSWORD=change-this-to-strong-password

# Session secret (random string, dùng để sign cookie)
SESSION_SECRET=generate-a-random-secret-here

# ============================================================
# Scheduler (mặc định: TẮT để an toàn)
# ============================================================

# Bật scheduler tự động fetch hàng ngày (false = tắt)
ENABLE_SCHEDULER=false

# Bật fetch ngay khi khởi động (false = tắt)
ENABLE_STARTUP_FETCH=false

# ============================================================
# Read-Only Mode (mặc định: BẬT để an toàn)
# ============================================================

# Read-only: chỉ cho phép đọc, chặn tất cả endpoint ghi/xóa
# Set READ_ONLY=false để bật tính năng đăng bài, quản lý comment, etc.
READ_ONLY=true
